{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_TALLY_API_URL",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_ADMIN_URL",
    "EXPO_PUBLIC_REVERB_HOST",
    "EXPO_PUBLIC_REVERB_APP_KEY",
    "EXPO_PUBLIC_REVERB_PORT",
    "EXPO_PUBLIC_REVERB_SCHEME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
