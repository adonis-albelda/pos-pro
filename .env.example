# Copy to apps/admin/.env.local and apps/mobile/.env.local respectively.
# Both apps point at the same Laravel API (the "Tally API") — it is the single source of truth.

# --- apps/admin (Next.js) ---
NEXT_PUBLIC_TALLY_API_URL=http://your-laravel-app.test/v1

# --- apps/mobile (Expo) ---
EXPO_PUBLIC_API_URL=https://your-laravel-app.example.com/v1
EXPO_PUBLIC_ADMIN_URL=https://your-admin-app.example.com

# --- apps/mobile realtime (Laravel Reverb) ---
EXPO_PUBLIC_REVERB_HOST=your-laravel-app.example.com
EXPO_PUBLIC_REVERB_APP_KEY=your-reverb-app-key
EXPO_PUBLIC_REVERB_PORT=443
EXPO_PUBLIC_REVERB_SCHEME=https

# --- apps/admin push notifications (Firebase Cloud Messaging, web) ---
# Same Firebase project the Laravel API's FIREBASE_CREDENTIALS points at.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# Web push certificate key — Firebase Console → Project settings → Cloud Messaging → Web configuration
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key
